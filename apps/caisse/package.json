{
  "name": "@opf/caisse",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "predist": "node scripts/predist.mjs",
    "dist": "npm run predist && npm run build && node scripts/electron-builder-win.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/dseg7-classic-mini": "^5.3.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@opf/caisse-core": "*",
    "buffer": "^6.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ma.janisol.opetitfrais.caisse",
    "productName": "OPetitFrais Caisse",
    "copyright": "Copyright © Janisol",
    "electronVersion": "33.2.1",
    "directories": {
      "output": "dist-win",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OPetitFrais-Caisse-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OPetitFrais Caisse"
    }
  }
}
