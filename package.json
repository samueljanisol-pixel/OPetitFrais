{
  "name": "o-petit-frais",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "npm run build:caisse-core && next build",
    "start": "next start",
    "lint": "eslint",
    "icons:pwa": "tsx scripts/generate-pwa-icons.ts",
    "sync:day": "tsx scripts/run-sync.ts",
    "sync:all": "tsx scripts/run-sync-all.ts",
    "build:caisse-core": "npm run build -w @opf/caisse-core",
    "dev:caisse-agent": "npm run dev -w @opf/caisse-agent",
    "dev:caisse": "npm run build:caisse-core && npm run dev -w @opf/caisse",
    "dist:caisse": "npm run build:caisse-core && npm run dist -w @opf/caisse",
    "upload:caisse-release": "tsx scripts/upload-caisse-release.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@opf/caisse-core": "*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@imgly/background-removal": "^1.7.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "@mui/stylis-plugin-rtl": "^9.0.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "basic-ftp": "^5.2.2",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "next": "16.2.3",
    "next-intl": "^4.12.0",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.34.5",
    "stylis": "^4.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stylis": "^4.2.7",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
